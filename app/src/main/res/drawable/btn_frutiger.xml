<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Capa base: cuerpo del botón con gradiente y bordes redondeados -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient
                android:startColor="@color/frutiger_azul_profundo"
                android:endColor="@color/frutiger_cian"
                android:angle="90"/>
            <stroke
                android:width="1dp"
                android:color="@color/frutiger_blanco_brillo"/>
        </shape>
    </item>

    <!-- Capa de brillo superior: simula el reflejo de vidrio -->
    <item android:top="2dp" android:left="4dp" android:right="4dp" android:bottom="26dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp"
                android:bottomLeftRadius="12dp"
                android:bottomRightRadius="12dp"/>
            <gradient
                android:startColor="#80FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90"/>
        </shape>
    </item>

</layer-list>