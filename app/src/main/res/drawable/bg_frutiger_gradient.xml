<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="800dp"
    android:viewportWidth="360"
    android:viewportHeight="800">

    <!-- Fondo base con degradado diagonal -->
    <path android:pathData="M0,0 L360,0 L360,800 L0,800 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="360"
                android:endY="800"
                android:startColor="#E1F5FE"
                android:centerColor="#4FC3F7"
                android:endColor="#01579B"/>
        </aapt:attr>
    </path>

    <!-- Líneas onduladas finas -->
    <path
        android:pathData="M -20,180 C 80,120 200,220 380,100"
        android:strokeColor="#66FFFFFF"
        android:strokeWidth="1.2"
        android:fillColor="#00000000"/>

    <path
        android:pathData="M -20,195 C 90,140 210,235 380,115"
        android:strokeColor="#4DFFFFFF"
        android:strokeWidth="1"
        android:fillColor="#00000000"/>

    <path
        android:pathData="M 260,420 C 300,480 270,560 330,650"
        android:strokeColor="#4DFFFFFF"
        android:strokeWidth="1.3"
        android:fillColor="#00000000"/>

    <path
        android:pathData="M 240,430 C 290,500 250,580 310,680"
        android:strokeColor="#33FFFFFF"
        android:strokeWidth="1"
        android:fillColor="#00000000"/>

    <!-- Burbuja grande superior izquierda -->
    <path android:pathData="M70,240 A60,60 0 1,0 70,360 A60,60 0 1,0 70,240 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="55"
                android:centerY="285"
                android:gradientRadius="70"
                android:startColor="#B3FFFFFF"
                android:centerColor="#4DB3E5FC"
                android:endColor="#1A4FC3F7"/>
        </aapt:attr>
    </path>

    <!-- Burbuja mediana centro-inferior -->
    <path android:pathData="M275,540 A45,45 0 1,0 275,630 A45,45 0 1,0 275,540 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="263"
                android:centerY="570"
                android:gradientRadius="55"
                android:startColor="#A6FFFFFF"
                android:centerColor="#404FC3F7"
                android:endColor="#1A0288D1"/>
        </aapt:attr>
    </path>

    <!-- Burbuja pequeña inferior izquierda -->
    <path android:pathData="M175,600 A35,35 0 1,0 175,670 A35,35 0 1,0 175,600 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="166"
                android:centerY="622"
                android:gradientRadius="42"
                android:startColor="#99FFFFFF"
                android:centerColor="#334FC3F7"
                android:endColor="#1A0288D1"/>
        </aapt:attr>
    </path>

    <!-- Burbuja pequeña derecha -->
    <path android:pathData="M320,470 A18,18 0 1,0 320,506 A18,18 0 1,0 320,470 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="315"
                android:centerY="480"
                android:gradientRadius="20"
                android:startColor="#99FFFFFF"
                android:centerColor="#334FC3F7"
                android:endColor="#1A0288D1"/>
        </aapt:attr>
    </path>

</vector>