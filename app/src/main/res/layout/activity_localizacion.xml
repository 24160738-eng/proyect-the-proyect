<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_frutiger_gradient"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        tools:context=".LocalizacionActivity">

        <TextView
            android:id="@+id/tvTituloLocalizacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubicación en tiempo real"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/frutiger_azul_profundo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvEstadoUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Esperando ubicación..."
            android:textSize="12sp"
            android:textColor="#888888"
            app:layout_constraintTop_toBottomOf="@id/tvTituloLocalizacion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp"/>

        <!-- Coordenadas en una fila compacta -->
        <LinearLayout
            android:id="@+id/layoutCoords"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvEstadoUbicacion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvCoordX"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="X: ---"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvCoordY"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Y: ---"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvPrecision"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="±--- m"
                android:textSize="13sp"/>

        </LinearLayout>

        <!-- Mapa: altura fija porque WebView no funciona con 0dp dentro de ScrollView -->
        <WebView
            android:id="@+id/webViewMapa"
            android:layout_width="383dp"
            android:layout_height="378dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutCoords" />

        <Button
            android:id="@+id/btnObtenerUbicacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Obtener ubicación"
            android:background="@drawable/btn_frutiger"
            android:textColor="@color/white"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:layout_constraintTop_toBottomOf="@id/webViewMapa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp"/>

        <Button
            android:id="@+id/btnVolverMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Regresar al menú"
            android:background="@drawable/btn_frutiger"
            android:textColor="@color/white"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:layout_constraintTop_toBottomOf="@id/btnObtenerUbicacion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>