<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        tools:context=".GuardarPacienteActivity">

        <TextView
            android:id="@+id/tvTituloPaciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar paciente"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etNombrePaciente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Nombre del paciente"
            android:inputType="textPersonName"
            app:layout_constraintTop_toBottomOf="@id/tvTituloPaciente"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <EditText
            android:id="@+id/etApellidoPaterno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Apellido paterno"
            android:inputType="textPersonName"
            app:layout_constraintTop_toBottomOf="@id/etNombrePaciente"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <!-- Apellido materno -->
        <EditText
            android:id="@+id/etApellidoMaterno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Apellido materno"
            android:inputType="textPersonName"
            app:layout_constraintTop_toBottomOf="@id/etApellidoPaterno"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etEdadPaciente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Edad"
            android:inputType="number"
            app:layout_constraintTop_toBottomOf="@id/etApellidoMaterno"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <!-- Fecha de nacimiento -->
        <TextView
            android:id="@+id/lblFechaNacimiento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha de nacimiento:"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/etEdadPaciente"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvFechaNacimiento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="No seleccionada"
            app:layout_constraintTop_toTopOf="@id/lblFechaNacimiento"
            app:layout_constraintStart_toEndOf="@id/lblFechaNacimiento"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btnSeleccionarFechaNacimiento"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Seleccionar fecha"
            app:layout_constraintTop_toBottomOf="@id/lblFechaNacimiento"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Género -->
        <TextView
            android:id="@+id/lblGenero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Género:"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/btnSeleccionarFechaNacimiento"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/spinnerGenero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/lblGenero"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Peso -->
        <EditText
            android:id="@+id/etPeso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Peso (kg)"
            android:inputType="numberDecimal"
            app:layout_constraintTop_toBottomOf="@id/spinnerGenero"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/lblDoctor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doctor asignado:"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/etPeso"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp" />

        <Spinner
            android:id="@+id/spinnerDoctor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/lblDoctor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <View
            android:id="@+id/divider1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            app:layout_constraintTop_toBottomOf="@id/spinnerDoctor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/tvTituloConsulta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Datos de la consulta"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp" />

        <FrameLayout
            android:id="@+id/frameConsulta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tvTituloConsulta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnGuardarPaciente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Guardar paciente y consulta"
            app:layout_constraintTop_toBottomOf="@id/frameConsulta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="28dp" />

        <Button
            android:id="@+id/btnVolverLocalizacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Regresar a Localización"
            app:layout_constraintTop_toBottomOf="@id/btnGuardarPaciente"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnIrVerPacientes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Ver pacientes"
            app:layout_constraintTop_toBottomOf="@id/btnVolverLocalizacion"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>