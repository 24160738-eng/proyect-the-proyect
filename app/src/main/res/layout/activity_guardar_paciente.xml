<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        tools:context=".GuardarPacienteActivity">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloPaciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrar paciente"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Nombre -->
        <EditText
            android:id="@+id/etNombrePaciente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Nombre del paciente"
            android:inputType="textPersonName"
            app:layout_constraintTop_toBottomOf="@id/tvTituloPaciente"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <!-- Edad -->
        <EditText
            android:id="@+id/etEdadPaciente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Edad"
            android:inputType="number"
            app:layout_constraintTop_toBottomOf="@id/etNombrePaciente"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <!-- Teléfono -->
        <EditText
            android:id="@+id/etTelefonoPaciente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Teléfono"
            android:inputType="phone"
            app:layout_constraintTop_toBottomOf="@id/etEdadPaciente"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <!-- Doctor (spinner con la lista de doctores) -->
        <TextView
            android:id="@+id/lblDoctor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doctor asignado:"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/etTelefonoPaciente"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp" />

        <Spinner
            android:id="@+id/spinnerDoctor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/lblDoctor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Separador visual -->
        <View
            android:id="@+id/divider1"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            app:layout_constraintTop_toBottomOf="@id/spinnerDoctor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/tvTituloConsulta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Datos de la consulta"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/divider1"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp" />

        <!-- Contenedor del fragment de consulta -->
        <FrameLayout
            android:id="@+id/frameConsulta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/tvTituloConsulta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <!-- Botón guardar -->
        <Button
            android:id="@+id/btnGuardarPaciente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Guardar paciente y consulta"
            app:layout_constraintTop_toBottomOf="@id/frameConsulta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>